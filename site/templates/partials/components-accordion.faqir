//- The accordion recipe, drawn from data. Parameters: id (unique on the
//- page) and items, each { question, answer }. Every item starts collapsed.
div(data-ui="accordion" data-variant="single" id=id)
  each item, i in items
    div(data-part="item" data-state="collapsed")
      button(type="button" data-part="trigger" id="{{ id }}-trigger-{{ i + 1 }}" aria-expanded="false" aria-controls="{{ id }}-content-{{ i + 1 }}")
        span {{ item.question }}
        span(data-part="icon" aria-hidden="true") ▾
      div(data-part="content" id="{{ id }}-content-{{ i + 1 }}" role="region" aria-labelledby="{{ id }}-trigger-{{ i + 1 }}" hidden)
        p {{ item.answer }}
