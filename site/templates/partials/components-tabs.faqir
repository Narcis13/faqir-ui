//- The tabs recipe, drawn from data. Parameters: id (unique on the page),
//- label (names the tab list) and tabs, each { label, text }. The first tab
//- is selected; the others are out of the tab order and their panels hidden,
//- exactly as the recipe's reference markup ships, so tabs.js takes it over.
div(data-ui="tabs" data-variant="underline")
  div(data-part="list" role="tablist" aria-label=label)
    each tab, i in tabs
      button(type="button" data-part="trigger" role="tab" id="{{ id }}-tab-{{ i + 1 }}" aria-controls="{{ id }}-panel-{{ i + 1 }}" aria-selected=i == 0 ? "true" : "false" tabindex=i == 0 ? false : "-1") {{ tab.label }}
  each tab, i in tabs
    div(data-part="panel" role="tabpanel" id="{{ id }}-panel-{{ i + 1 }}" aria-labelledby="{{ id }}-tab-{{ i + 1 }}" hidden=i != 0)
      p {{ tab.text }}
