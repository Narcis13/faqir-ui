//- One example, three ways: the template, the data it was given, and what
//- render() wrote, live. Parameter: example, one entry of a page's ex.
div(data-docs-template-example)
  div(data-docs-template-pane="source")
    div(data-docs-template-label)
      +badge Template
      +text(variant="mono" size="sm") {{ example.file }}
    pre(tabindex="0")
      code {{ example.source }}
    each dep in example.deps
      div(data-docs-template-label)
        +badge Loads
        +text(variant="mono" size="sm") {{ dep.file }}
      pre(tabindex="0")
        code {{ dep.source }}
  div(data-docs-template-pane="data")
    div(data-docs-template-label)
      +badge Data
    pre(tabindex="0")
      code {{ example.data }}
    if example.options != ""
      div(data-docs-template-label)
        +badge Options
      pre(tabindex="0")
        code {{ example.options }}
  div(data-docs-template-pane="result")
    div(data-docs-template-label)
      +badge(variant="success") Rendered
    div(data-docs-template-result)
      raw example.html
    +collapsible
      @trigger The HTML it wrote
      @content
        pre(tabindex="0")
          code {{ example.html }}
