import { createFaqirPrimitive } from "../runtime.js";
import type { ComponentPropsWithoutRef } from "react";

/** Allowed \`gap\` values (manifest variant group "gap", attr \`data-gap\`). */
export type LClusterGap = "0" | "1" | "2" | "3" | "4" | "6" | "8" | "10" | "12" | "16";

/** Allowed \`align\` values (manifest variant group "align", attr \`data-align\`). */
export type LClusterAlign = "start" | "center" | "end" | "stretch" | "baseline";

/** Allowed \`justify\` values (manifest variant group "justify", attr \`data-justify\`). */
export type LClusterJustify = "start" | "center" | "end" | "between" | "around";

export interface LClusterProps extends Omit<ComponentPropsWithoutRef<"div">, "gap" | "gapSm" | "gapMd" | "gapLg" | "gapXl" | "align" | "alignSm" | "alignMd" | "alignLg" | "alignXl" | "justify" | "justifySm" | "justifyMd" | "justifyLg" | "justifyXl" | "push"> {
  /** \`data-gap\`; omitted when unset (manifest default: "2"). */
  gap?: LClusterGap;
  /** \`data-gap-sm\` — the \`gap\` value from the \`sm\` breakpoint up; omitted when unset. */
