  /** \`data-gap-md\` — the \`gap\` value from the \`md\` breakpoint up; omitted when unset. */
  gapMd?: LClusterGap;
  /** \`data-gap-lg\` — the \`gap\` value from the \`lg\` breakpoint up; omitted when unset. */
