    { prop: "gapXl", attr: "data-gap-xl", values: ["0", "1", "2", "3", "4", "6", "8", "10", "12", "16"] },
    { prop: "align", attr: "data-align", values: ["start", "center", "end", "stretch", "baseline"] },
    { prop: "alignSm", attr: "data-align-sm", values: ["start", "center", "end", "stretch", "baseline"] },
    { prop: "alignMd", attr: "data-align-md", values: ["start", "center", "end", "stretch", "baseline"] },
    { prop: "alignLg", attr: "data-align-lg", values: ["start", "center", "end", "stretch", "baseline"] },
    { prop: "alignXl", attr: "data-align-xl", values: ["start", "center", "end", "stretch", "baseline"] },
    { prop: "justify", attr: "data-justify", values: ["start", "center", "end", "between", "around"] },
    { prop: "justifySm", attr: "data-justify-sm", values: ["start", "center", "end", "between", "around"] },
    { prop: "justifyMd", attr: "data-justify-md", values: ["start", "center", "end", "between", "around"] },
    { prop: "justifyLg", attr: "data-justify-lg", values: ["start", "center", "end", "between", "around"] },
    { prop: "justifyXl", attr: "data-justify-xl", values: ["start", "center", "end", "between", "around"] },
