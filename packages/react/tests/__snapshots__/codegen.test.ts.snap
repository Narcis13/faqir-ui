  /** \`data-align-md\` — the \`align\` value from the \`md\` breakpoint up; omitted when unset. */
  alignMd?: LClusterAlign;
  /** \`data-align-lg\` — the \`align\` value from the \`lg\` breakpoint up; omitted when unset. */
  alignLg?: LClusterAlign;
  /** \`data-align-xl\` — the \`align\` value from the \`xl\` breakpoint up; omitted when unset. */
  alignXl?: LClusterAlign;
  /** \`data-justify\`; omitted when unset (manifest default: "start"). */
  justify?: LClusterJustify;
  /** \`data-justify-sm\` — the \`justify\` value from the \`sm\` breakpoint up; omitted when unset. */
  justifySm?: LClusterJustify;
  /** \`data-justify-md\` — the \`justify\` value from the \`md\` breakpoint up; omitted when unset. */
  justifyMd?: LClusterJustify;
  /** \`data-justify-lg\` — the \`justify\` value from the \`lg\` breakpoint up; omitted when unset. */
  justifyLg?: LClusterJustify;
  /** \`data-justify-xl\` — the \`justify\` value from the \`xl\` breakpoint up; omitted when unset. */
  justifyXl?: LClusterJustify;
  /** Written on a CHILD of the cluster, never the root: that child — and everything after it — is pushed to the far end of the row (margin-inline-start: auto). The "actions on the right" idiom, and logical, so it is the far end in RTL too. */
  push?: boolean;
}

/** \`cluster\` — A wrapping inline row — tag rows, button rows, meta rows. Children flow along one line and reflow onto the next when they run out of room, with no breakpoint involved; gap, alignment and justification are responsive on the canon tiers */
