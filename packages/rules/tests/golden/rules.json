        { "id": "loose", "compute": "loose", "value": { "==": [{ "var": "answer" }, 1] } },
        { "id": "strict", "compute": "strict", "value": { "===": [{ "var": "answer" }, 1] } }
      ]
    },
    "data": { "answer": "1" },
    "expected": { "valid": true, "findings": [], "computed": { "loose": true, "strict": false } }
