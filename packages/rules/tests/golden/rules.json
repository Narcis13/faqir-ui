  {
    "name": "logic: an empty array is falsy, so an empty checkbox group hides its hint",
    "definition": {
      "version": "1",
      "fields": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "tag_hint": { "type": "string", "required": true }
      },
      "rules": [
        { "id": "hint-when-tagged", "show": "tag_hint", "when": { "var": "tags" } },
        { "id": "tagged", "compute": "tagged", "value": { "!!": [{ "var": "tags" }] } }
      ]
    },
    "data": { "tags": [] },
