      ]
    },
    "data": { "email": "ada+news@example.com" },
    "expected": {
      "valid": false,
      "findings": [
        { "path": "email", "rule": "no-plus-addressing",
          "message": "Plus addressing is not accepted here.", "params": {} }
      ]
    }
  },
  {
    "name": "logic: `missing` answers with a list, and an empty list is falsy",
    "definition": {
      "version": "1",
      "fields": {
