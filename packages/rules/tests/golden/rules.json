  {
    "name": "rules: every map at once — computed drives a require, a rule fails, a remote waits, a page points on",
    "definition": {
      "version": "1",
      "fields": {
        "qty": { "type": "integer" }, "price": { "type": "number" },
        "total": { "type": "number" }, "po_number": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "rules": [
        { "id": "total", "compute": "total", "value": { "*": [{ "var": "qty" }, { "var": "price" }] } },
        { "id": "po-for-large-orders", "require": "po_number", "when": { ">": [{ "var": "total" }, 500] } },
        { "id": "under-credit-limit", "validate": { "<=": [{ "var": "total" }, 900] }, "path": "total",
          "message": "This order is over your credit limit." },
        { "id": "email-free", "validate": "remote", "path": "email", "remote": "/api/email-free" },
        { "id": "to-approval", "jump": "approval", "from": "cart", "when": { ">": [{ "var": "total" }, 500] } }
      ]
    },
    "data": { "qty": 100, "price": 10, "email": "ada@example.com" },
    "expected": {
      "valid": false,
      "computed": { "total": 1000 },
      "required": { "po_number": true },
      "next": { "cart": "approval" },
      "pending": ["email-free"],
      "findings": [
        { "path": "po_number", "rule": "required", "message": "This field is required.", "params": {} },
        { "path": "total", "rule": "under-credit-limit",
          "message": "This order is over your credit limit.", "params": {} }
      ]
    }
  }
