{
  "name": "@faqir-ui/rules",
  "version": "1.0.0",
  "description": "Isomorphic, zero-dependency form rules \u2014 JSON Schema subset shape validation, formats, messages and coercion",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "import": "./src/plugin.js",
      "default": "./src/plugin.js"
    },
    "./package.json": "./package.json",
    "./rules.schema.json": "./rules.schema.json"
  },
  "files": [
    "src",
    "rules.schema.json",
    "README.md"
  ],
  "//sideEffects": "./src/plugin.js self-registers with a global Faqir on import \u2014 that IS its purpose, so it may never be tree-shaken away. Everything else in src/ is pure.",
  "sideEffects": [
    "./src/plugin.js"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "faqir",
    "rules",
    "validation",
    "json-schema",
    "zero-dependency",
    "isomorphic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narcis13/faqir-ui.git",
    "directory": "packages/rules"
  },
  "homepage": "https://github.com/Narcis13/faqir-ui/tree/main/packages/rules#readme",
  "bugs": {
    "url": "https://github.com/Narcis13/faqir-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
